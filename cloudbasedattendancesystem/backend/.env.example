# Environment Configuration for Cloud-Based Attendance Management System

# Application Environment: development | production | testing
FLASK_ENV=development
DEBUG=True
PORT=5000

# Security Secrets (Must be changed in production!)
SECRET_KEY=dev-flask-secret-key-change-in-production-random-bytes-32
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-random-bytes-32
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=480

# MongoDB Cloud / Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
# For local development without Atlas cluster, leave empty to automatically run in offline mongomock mode
MONGODB_URI=mongodb+srv://dbUser:yourPassword@cluster0.abcde.mongodb.net/cloud_attendance?retryWrites=true&w=majority
MONGODB_DATABASE=cloud_attendance

# CORS and Allowed Origins (comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Institution Academic Settings
MIN_ATTENDANCE_PERCENTAGE=75.0
WARNING_ATTENDANCE_PERCENTAGE=80.0
INSTITUTION_NAME=Apex Institute of Engineering & Technology
